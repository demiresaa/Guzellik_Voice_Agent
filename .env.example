# ============================================================================
# Güzellik Salonu Booking Agent - Environment Configuration
# Distributed Microservices Architecture
# ============================================================================

# ============================================================================
# ENVIRONMENT
# ============================================================================
ENVIRONMENT=development
# Options: development, staging, production

# ============================================================================
# SECURITY (REQUIRED - Generate with: python -c "import secrets; print(secrets.token_hex(32))")
# ============================================================================
API_KEY=fb62b8695cb1ec820948423d49eebe325764271c31b9af3cbb1584572cb453d6
JWT_SECRET=your_jwt_secret_min_32_chars_for_token_signing

# ============================================================================
# GEMINI API (Required for Conversation Agent)
# ============================================================================
GEMINI_API_KEY=AIzaSyALd5jQuOSLn2_CWrsPCp708g_tfCxsbig
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_TEMPERATURE=0.7
GEMINI_MAX_TOKENS=2048

# ============================================================================
# DATABASE - PostgreSQL (Required for Production)
# ============================================================================
# Development (local PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/guzellik_booking

# Production (use connection pooling)
# DATABASE_URL=postgresql+asyncpg://user:password@db-host:5432/dbname
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# ============================================================================
# REDIS - Caching & Sessions (Required for Production)
# ============================================================================
# Development (local Redis)
REDIS_URL=redis://localhost:6379/0

# Production (use Redis cluster)
# REDIS_URL=redis://redis-host:6379/0
# REDIS_URL=rediss://user:password@redis-host:6379/0  # SSL
REDIS_TTL_SECONDS=1800

# ============================================================================
# SERVICE URLS (Microservices Communication)
# ============================================================================
BOOKING_AGENT_URL=http://localhost:8001
CONVERSATION_AGENT_URL=http://localhost:8002
VOICE_INTERFACE_URL=http://localhost:8000

# ============================================================================
# CONVERSATION AGENT SERVICE (Port 8002)
# ============================================================================
# SSE Configuration
SSE_RETRY_TIMEOUT_MS=3000
SSE_HEARTBEAT_INTERVAL_SECONDS=15

# Session Management
SESSION_TTL_SECONDS=1800
MAX_CONTEXT_MESSAGES=20

# Tool Calling
TOOL_CALL_MAX_ITERATIONS=10
TOOL_CALL_TIMEOUT_SECONDS=30

# ============================================================================
# LOGGING & OBSERVABILITY
# ============================================================================
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL

LOG_FORMAT=json
# Options: json (production), text (development)

# Metrics & Tracing
ENABLE_METRICS=True
ENABLE_TRACING=False
JAEGER_ENDPOINT=http://localhost:14268/api/traces

# ============================================================================
# SECURITY & RATE LIMITING
# ============================================================================
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60

# CORS
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000","http://localhost:8002"]

# ============================================================================
# SPEECH-TO-TEXT (STT) - Voice Transcription
# ============================================================================
# Provider Selection
STT_PROVIDER=faster-whisper
# Options: openai, faster-whisper

# Fallback Configuration
STT_FALLBACK_ENABLED=true
STT_FALLBACK_PROVIDER=openai
# Optional: If not specified, auto-selects opposite of primary

# OpenAI Whisper API Settings (Required if using OpenAI provider)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_WHISPER_MODEL=whisper-1
OPENAI_TIMEOUT=30
OPENAI_MAX_RETRIES=3

# Faster-Whisper Local Settings
FASTER_WHISPER_MODEL=base
# Options: tiny, tiny.en, base, base.en, small, small.en, medium, medium.en, large-v2, large-v3

FASTER_WHISPER_DEVICE=auto
# Options: cpu, cuda, auto (auto-detects GPU)

FASTER_WHISPER_COMPUTE_TYPE=auto
# Options: int8 (CPU), float16 (GPU), float32, auto

FASTER_WHISPER_CPU_THREADS=4
FASTER_WHISPER_NUM_WORKERS=1

# General STT Settings
STT_DEFAULT_LANGUAGE=auto
# Options: auto (auto-detect), tr (Turkish), en (English)

STT_MAX_AUDIO_SIZE_MB=25
STT_CACHE_ENABLED=false
STT_CACHE_TTL_SECONDS=3600

# Performance Tuning
STT_ENABLE_VAD=true
# Voice Activity Detection (faster-whisper only)

STT_BEAM_SIZE=5
# Beam search size (1-20, higher = more accurate but slower)

STT_TEMPERATURE=0.0
# Sampling temperature (0.0 = deterministic, 1.0 = creative)

# ============================================================================
# EXTERNAL SERVICES (Optional - for production)
# ============================================================================
# SMS Provider (Twilio, Vonage, etc.)
# SMS_PROVIDER_API_KEY=your_sms_provider_key
# SMS_PROVIDER_URL=https://api.sms-provider.com/send

# Payment Provider (Stripe, iyzico, etc.)
# PAYMENT_PROVIDER_API_KEY=your_payment_provider_key
# PAYMENT_PROVIDER_URL=https://api.payment-provider.com

# ============================================================================
# BUSINESS RULES
# ============================================================================
APPOINTMENT_DURATION_MINUTES=60
CANCELLATION_WINDOW_HOURS=24
PREPAYMENT_THRESHOLD_TRY=500.0

# ============================================================================
# HEALTH CHECKS
# ============================================================================
HEALTH_CHECK_INTERVAL_SECONDS=30
DEFAULT_TIMEOUT_SECONDS=30
